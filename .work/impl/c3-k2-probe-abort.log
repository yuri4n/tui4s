//> using scala 3.9.0
//> using dep io.getkyo::kyo-core:1.0.0-RC7
import kyo.*

object AbortProbe extends KyoApp:
  def safe(label: String, v: => Any < Async)(using Frame): String < Async =
    Abort.run[Throwable](v).map {
      case Result.Success(_) => s"$label: success"
      case Result.Failure(e) => s"$label: failure ${e.getClass.getSimpleName}"
      case Result.Panic(e)   => s"$label: panic ${e.getClass.getSimpleName}"
    }
  run {
    for
      a <- safe("throw in Sync.defer", Sync.defer(throw new IllegalStateException("boom")))
      b <- safe("Abort.panic", Abort.panic(new IllegalStateException("panic")))
      c <- safe("plain value", Sync.defer(42))
      d <- safe("throw in a mapped step", Sync.defer(1).map(_ => throw new RuntimeException("later")))
      e <- Abort.run[Throwable](Sync.defer(throw new IllegalStateException("after")))
           .map(_ => "the step after a caught throw runs")
    yield
      Console.printLine(a).andThen(Console.printLine(b)).andThen(Console.printLine(c))
        .andThen(Console.printLine(d)).andThen(Console.printLine(e))
  }
