package tui4s.internal


// PERF SPIKE (temporary, never commit): a background thread that does startup
// work off the main thread while Kyo starts. No terminal change and no output:
// -Dtui4s.prewarm.native=true loads the crossterm JNI library and links the
// isatty downcall; -Dtui4s.prewarm.list=<file> loads (without initializing)
// the classes named in the file, in order.
private[tui4s] object PerfPrewarm:
    def start(): Unit =
        val list = java.lang.System.getProperty("tui4s.prewarm.list")
        val nat  = java.lang.Boolean.getBoolean("tui4s.prewarm.native")
        if list != null || nat then
            val loader = classOf[PerfMark.type].getClassLoader
            val t      = new Thread(
              () => {
                PerfMark("prewarm-start")
                if nat then
                    try discard(Class.forName("tui.crossterm.CrosstermJni", true, loader))
                    catch case _: Throwable => ()
                    PerfMark("prewarm-jni")
                    try discard(Tty.isatty(0))
                    catch case _: Throwable => ()
                    PerfMark("prewarm-tty")
                if list != null then
                    val names = java.nio.file.Files.readAllLines(java.nio.file.Path.of(list)).nn
                    var n     = 0
                    names.forEach { name =>
                      try
                          discard(Class.forName(name, false, loader))
                          n += 1
                      catch case _: Throwable => ()
                    }
                    PerfMark(s"prewarm-list-done $n")
              },
              "tui4s-prewarm",
            )
            t.setDaemon(true)
            t.start()
        end if
    end start
end PerfPrewarm
