package tui4s.internal

// PERF SPIKE (temporary, never commit): timestamps (System.nanoTime, the
// CLOCK_MONOTONIC of Linux) into the file of -Dtui4s.perf=<file>. A no-op
// without the property.
private[tui4s] object PerfMark:
    private val out: java.io.FileOutputStream | Null =
        val p = java.lang.System.getProperty("tui4s.perf")
        if p == null then null else new java.io.FileOutputStream(p, true)

    def apply(label: String): Unit =
        val o = out
        if o != null then
            val line =
              s"${java.lang.System.nanoTime()} ${Thread.currentThread().nn.getName} $label\n"
            o.synchronized(o.write(line.getBytes))

    /** Starts a daemon thread that samples the stacks of the other threads
      * every 2 ms for `ms` (only with -Dtui4s.perf.sample=true).
      */
    def sampler(ms: Int): Unit =
        val o = out
        if o != null && java.lang.Boolean.getBoolean("tui4s.perf.sample") then
            val t = new Thread(() => {
              val end = java.lang.System.nanoTime() + ms * 1_000_000L
              while java.lang.System.nanoTime() < end do
                  val now = java.lang.System.nanoTime()
                  val sb  = new java.lang.StringBuilder
                  Thread.getAllStackTraces().nn.forEach { (th, st) =>
                    val n = th.nn.getName
                    if th ne Thread.currentThread() then
                        if st.nn.length > 0 && (n == "main" || n.nn.startsWith("kyo")) then
                            val top = st.nn.take(8).map(f => s"${f.nn.getClassName}.${f.nn.getMethodName}:${f.nn.getLineNumber}").mkString(" < ")
                            sb.append(s"$now SAMPLE ${n} ${th.nn.getState} $top\n")
                  }
                  o.synchronized(o.write(sb.toString.getBytes))
                  Thread.sleep(2)
            }, "tui4s-perf-sampler")
            t.setDaemon(true)
            t.start()
end PerfMark
