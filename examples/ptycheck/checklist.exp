#!/usr/bin/expect -f
# The real-terminal checklist of the examples, with no human. It drives the
# start scripts in examples/target/bin in a pseudo-terminal of 100x30, writes
# @@MARK name@@ lines into the session log (check.py replays the output between
# the marks with vt.py and checks the screens), checks raw mode from outside
# while the app runs, and compares `stty -a` before and after each run.
# Run it with run.sh, which builds the launchers first.
# Usage: expect checklist.exp <bin dir> <work dir> <session log>
# Results and notes are printed only after the session log is closed:
# `log_file -a` also logs send_user output, and vt.py would draw that text onto
# the replayed screens.
# claude 2026-10-13: changed (T1, RC-31 part): the Counter rows of plan 6.5 for
# the launcher of examples.counter.CounterKyoApp (the prototype ran the apps
# of an assembly jar; the Todo rows come with the Todo example in T2)
# claude 2026-10-13: changed (T1, reviews R3-3, R3-9): exit code 1 only for
# the pipe and the deny rows; no app pid is a FAIL row; stty -a around the
# resize run; no SKIP rows (none is used)
# claude 2026-10-13: changed (T2, RC-31 rest, OS-19): the rows of all the
# examples: kill -TERM (143) and kill -INT (130) from outside, a println while
# the UI is up (printing, with and without --log), the KyoApp main
# (counterkyo), CounterStyles, Todo (typing, Enter, a paste, Tab, Space,
# Ctrl-S and its file, Esc), Dashboard (live, pause, the tabs, a resize, q),
# and the INFO run of the class-load count

set timeout 40
set bin  [file normalize [lindex $argv 0]]
set work [file normalize [lindex $argv 1]]
log_user 0
log_file -a -noappend [lindex $argv 2]
set results {}
proc pass {name} { global results; lappend results "PASS $name" }
proc fail {name why} { global results; lappend results "FAIL $name: $why" }
proc mark {name} { send_log "\n@@MARK $name@@\n" }

spawn -noecho /bin/bash --norc --noprofile
set shell [exp_pid]
set slave $spawn_out(slave,name)
exec stty rows 30 columns 100 < $slave
send "PS1='PROMPT> '; export TERM=xterm-256color; cd $work\r"
expect -ex "PROMPT> "
expect -ex "PROMPT> "

proc wait_prompt {} { expect -ex "PROMPT> " }

# Read (and so log) everything the app prints for about ms milliseconds.
proc pump {ms} {
    set end [expr {[clock milliseconds] + $ms}]
    while {[clock milliseconds] < $end} {
        expect -timeout 1 -re {.+} {} timeout {}
    }
}

# Read (and so log) the output until the streamed reply of the assistant has
# ended: the status bar shows the spinner ("streaming"), then "ready" again.
# The status bar writes the reply's token count before "ready". A slow machine
# streams for longer than a fixed pump (the macOS runner of CI), so this waits
# for the end, at most ms milliseconds, then pumps 500 ms more: the screen at
# the next mark is the first screen after the end of the reply. Returns the
# milliseconds from the call to "ready", or -1 when the bound came first.
# claude 2026-10-20: created: the wait for the end of the streamed reply
proc await_reply {ms} {
    set t0 [clock milliseconds]
    set end [expr {$t0 + $ms}]
    foreach text {streaming ready} {
        set left [expr {max(1, ($end - [clock milliseconds] + 999) / 1000)}]
        set seen 0
        expect -timeout $left -ex $text { set seen 1 } timeout {}
        if {!$seen} { pump 500; return -1 }
    }
    set took [expr {[clock milliseconds] - $t0}]
    pump 500
    return $took
}

proc stty_save {name when} {
    global work
    send "stty -a > $work/stty-$name-$when.txt; echo STTY_\$((6*7))SAVED\r"
    expect -ex "STTY_42SAVED"
    wait_prompt
}

proc stty_compare {name} {
    global work
    stty_save $name after
    send "cmp -s $work/stty-$name-before.txt $work/stty-$name-after.txt && echo STTY_\$((7*0))SAME || echo STTY_\$((7*0))DIFF\r"
    expect {
        -ex "STTY_0SAME" { pass "$name: stty -a after the exit equals stty -a before the start" }
        -ex "STTY_0DIFF" { fail $name "stty -a differs after the exit (see $work/stty-$name-*.txt)" }
        timeout { fail $name "no stty comparison" }
    }
    wait_prompt
}

proc run_app {cmd} {
    global started
    set started [clock milliseconds]
    send "$cmd; echo EXIT=\$?\r"
}

# The app is ready when it has entered the alternate screen and drawn the text.
# The text must be one run of cells: the runner sends only the cells that
# change, so "Count: 0" comes as "Count:", a cursor move and "0".
proc first_frame {name text} {
    global started
    expect {
        -ex "\x1b\[?1049h" { pass "$name: entered the alternate screen" }
        timeout { fail $name "never entered the alternate screen"; return 0 }
    }
    expect {
        -ex $text { pass "$name: first frame drawn ([expr {[clock milliseconds] - $started}] ms after the start command, JVM start included)" }
        timeout { fail $name "no first frame (waited for '$text')"; return 0 }
    }
    pump 500
    return 1
}

# Raw mode, read from outside on the PTY slave while the app runs.
proc raw_check {name} {
    global slave work
    set modes [exec stty -a < $slave]
    set f [open "$work/stty-$name-running.txt" w]; puts $f $modes; close $f
    if {[regexp {(^|\s)-icanon(\s|$)} $modes] && [regexp {(^|\s)-echo(\s|$)} $modes] && [regexp {(^|\s)-isig(\s|$)} $modes]} {
        pass "$name: raw mode while running (-icanon -echo -isig)"
    } else {
        fail $name "not in raw mode while running: $modes"
    }
}

proc back_at_prompt {name {codes {0}}} {
    expect {
        -re {EXIT=([0-9]+)} {
            set code $expect_out(1,string)
            if {[lsearch -exact $codes $code] >= 0} { pass "$name: exit code $code" } else { fail $name "exit code $code, expected $codes" }
        }
        timeout { fail $name "the app did not exit"; send "\003"; return }
    }
    wait_prompt
}

# The PID of the app: the child of the shell in the pseudo-terminal (the
# launcher execs java). Empty when pgrep finds none.
proc app_pid {} {
    global shell
    if {[catch {exec pgrep -P $shell -n} pid]} { return "" }
    return [string trim $pid]
}

# ---- Counter: + + - then q
stty_save counter before
mark "counter-start"
run_app "$bin/counter"
if {[first_frame "counter" "Count:"]} {
    raw_check "counter"
    mark "counter-plus1";  send "+"; pump 500
    mark "counter-plus2";  send "+"; pump 500
    mark "counter-minus";  send -- "-"; pump 500
    mark "counter-q";      send "q"
}
back_at_prompt "counter q"
stty_compare "counter"

# ---- Counter: Ctrl-C quits (the key: raw mode sends no signal), exit 0
stty_save ctrlc before
mark "ctrlc-start"
run_app "$bin/counter"
if {[first_frame "counter ctrl-c" "Count:"]} {
    mark "ctrlc-plus"; send "+"; pump 500
    mark "ctrlc-key";  send "\003"
}
back_at_prompt "counter ctrl-c"
stty_compare "ctrlc"

# ---- Counter: a resize (SIGWINCH) lays the screen out again
stty_save resize before
mark "resize-start"
run_app "$bin/counter"
if {[first_frame "counter resize" "Count:"]} {
    set pid [app_pid]
    if {$pid eq ""} { fail "counter resize" "no app pid (pgrep -P $shell)" }
    mark "resize-small"
    exec stty rows 20 columns 40 < $slave
    catch {exec kill -WINCH $pid}
    pump 1000
    mark "resize-big"
    exec stty rows 30 columns 100 < $slave
    catch {exec kill -WINCH $pid}
    pump 1000
    mark "resize-q"; send "q"
}
back_at_prompt "counter resize"
stty_compare "resize"

# claude 2026-10-13: created (T2): the rows below, to the pipe row

# The app is ready, with no PASS row (the INFO run): FAIL only when it never
# draws `text`.
proc ready_quiet {name text} {
    expect {
        -ex $text { pump 500; return 1 }
        timeout { fail $name "no first frame (waited for '$text')"; return 0 }
    }
}

# Sends `sig` to the app after its first frame; check.py checks the restore.
proc kill_row {name sig code} {
    global bin shell
    stty_save $name before
    mark "$name-start"
    run_app "$bin/counter"
    if {[first_frame "counter kill -$sig" "Count:"]} {
        set pid [app_pid]
        if {$pid eq ""} {
            fail "counter kill -$sig" "no app pid (pgrep -P $shell)"
            send "q"
        } else {
            mark "$name-kill"
            exec kill -$sig $pid
        }
    }
    back_at_prompt "counter kill -$sig" [list $code]
    stty_compare $name
}

# ---- Counter: kill -TERM and kill -INT from outside: 143 and 130 (128 + the
# signal), the terminal restored (TuiApp's stop hook)
kill_row term TERM 143
kill_row int INT 130
# claude 2026-10-19: created: kill -HUP (a closed terminal window): 129
kill_row hup HUP 129

# ---- Printing: a println while the UI is up is captured; the lines come
# after the restore, or into the log file with --log
# claude 2026-10-13: changed (T2, review R1-1): the app prints one line before
# the run too (it comes before the UI, check.py); the log file has only the two
# lines of the run (no R3 warning)
stty_save print before
mark "print-start"
run_app "$bin/printing"
if {[first_frame "printing" "Count:"]} {
    mark "print-plus"; send "+"; pump 500
    mark "print-q";    send "q"
}
back_at_prompt "printing"
stty_compare "print"

set printlog "$work/printing.log"
file delete -force $printlog
stty_save printlog before
mark "printlog-start"
run_app "$bin/printing --log printing.log"
if {[first_frame "printing --log" "Count:"]} {
    mark "printlog-plus"; send "+"; pump 500
    mark "printlog-q";    send "q"
}
back_at_prompt "printing --log"
stty_compare "printlog"
if {[file exists $printlog]} {
    set fh [open $printlog r]; set content [read $fh]; close $fh
    set want "printing: the UI is built\nprinting: + gives 1\n"
    if {$content eq $want} {
        pass "printing --log: the log file has the two printed lines of the run, and nothing more"
    } else {
        fail "printing --log" "the log file has: [string map {"\n" "\\n"} $content]"
    }
} else {
    fail "printing --log" "no file $printlog"
}

# ---- Printing --fail-on-f: the key f fails the UI (a render fails); exit
# code 1, the failure printed after the restore, nothing on the screen
# claude 2026-10-19: created: the row of a failure inside the running UI
stty_save printfail before
mark "printfail-start"
run_app "$bin/printing --fail-on-f"
if {[first_frame "printing --fail-on-f" "Count:"]} {
    mark "printfail-f"; send "f"
}
back_at_prompt "printing --fail-on-f" {1}
stty_compare "printfail"

# ---- Counter with its own main (KyoApp): + then q
stty_save kyoapp before
mark "kyoapp-start"
run_app "$bin/counterkyo"
if {[first_frame "counterkyo" "Count:"]} {
    mark "kyoapp-plus"; send "+"; pump 500
    mark "kyoapp-q";    send "q"
}
back_at_prompt "counterkyo"
stty_compare "kyoapp"

# ---- CounterStyles: + on a hook counter, + on a Component counter, h twice
stty_save styles before
mark "styles-start"
run_app "$bin/counterstyles"
if {[first_frame "counterstyles" "Components"]} {
    mark "styles-hook"; send "\r"; pump 500
    mark "styles-tabs"; send "\t\t\t\t"; pump 500
    mark "styles-comp"; send "\r"; pump 500
    mark "styles-hide"; send "h"; pump 500
    mark "styles-show"; send "h"; pump 800
    mark "styles-q";    send "q"
}
back_at_prompt "counterstyles"
stty_compare "styles"

# ---- Todo: type, Enter, a paste of one line, a paste with a line break,
# Enter, Tab, Space, Ctrl-S (the file), Esc. The file is in the work dir (the
# shell's directory).
set todofile "$work/todo-pty.txt"
file delete -force $todofile
stty_save todo before
mark "todo-start"
run_app "$bin/todo todo-pty.txt"
if {[first_frame "todo" "Todo"]} {
    raw_check "todo"
    mark "todo-typed";  send "buy milk"; pump 600
    mark "todo-enter";  send "\r"; pump 500
    mark "todo-paste";  send "\x1b\[200~tea time\x1b\[201~"; pump 500
    mark "todo-paste2"; send "\x1b\[200~\nand cake\x1b\[201~"; pump 500
    mark "todo-enter2"; send "\r"; pump 500
    mark "todo-tab";    send "\t"; pump 500
    mark "todo-space";  send " "; pump 500
    mark "todo-ctrls";  send "\x13"; pump 800
    mark "todo-esc";    send "\x1b"
}
back_at_prompt "todo"
stty_compare "todo"
if {[file exists $todofile]} {
    set fh [open $todofile r]; set content [read $fh]; close $fh
    if {$content eq "\[x\] buy milk\n\[ \] tea time and cake\n"} {
        pass "todo: the saved file has '\[x\] buy milk' and '\[ \] tea time and cake'"
    } else {
        fail "todo file" "content: [string map {"\n" "\\n"} $content]"
    }
} else {
    fail "todo file" "no file $todofile"
}

# ---- Dashboard: live (two screens 1 s apart), p pauses (two screens 1 s
# apart), the arrows, Tab with Space and Enter on the tabs, a resize, q
stty_save dash before
mark "dash-start"
run_app "$bin/dashboard"
if {[first_frame "dashboard" "Dashboard"]} {
    set pid [app_pid]
    if {$pid eq ""} { fail "dashboard" "no app pid (pgrep -P $shell)" }
    raw_check "dash"
    pump 500
    mark "dash-live1";   pump 1000
    mark "dash-live2";   pump 1000
    mark "dash-pause";   send "p"; pump 600
    mark "dash-paused1"; pump 1000
    mark "dash-paused2"; pump 1000
    mark "dash-resume";  send "p"; pump 500
    mark "dash-right";   send "\x1b\[C"; pump 500
    mark "dash-left";    send "\x1b\[D"; pump 500
    mark "dash-tab";     send "\t"; pump 500
    mark "dash-space";   send " "; pump 500
    mark "dash-tab2";    send "\t"; pump 500
    mark "dash-enter";   send "\r"; pump 500
    mark "dash-small"
    exec stty rows 20 columns 40 < $slave
    if {$pid ne ""} { catch {exec kill -WINCH $pid} }
    pump 1000
    mark "dash-big"
    exec stty rows 30 columns 100 < $slave
    if {$pid ne ""} { catch {exec kill -WINCH $pid} }
    pump 1000
    mark "dash-q"; send "q"
}
back_at_prompt "dashboard"
stty_compare "dash"

# ---- Forms: the first screen (the terminal cursor in the name field), 10
# Tabs to the textarea, a Alt-Enter b Ctrl-J c (three lines), Enter (the
# submit), then Esc
# claude 2026-10-19: created (L1c); changed: the cursor, the newline keys and
# the submit (L1c review)
stty_save forms before
mark "forms-start"
run_app "$bin/forms"
if {[first_frame "forms" "Sign up"]} {
    pump 500
    mark "forms-tabs"
    for {set i 0} {$i < 10} {incr i} { send "\t"; pump 150 }
    pump 300
    mark "forms-lines"; send "a\x1b\rb\nc"; pump 800
    mark "forms-enter"; send "\r"; pump 800
    mark "forms-esc"; send "\x1b"
}
back_at_prompt "forms"
stty_compare "forms"

# ---- Gallery: the first screen, ArrowDown on the family list (the data
# family), then Ctrl-Q
# claude 2026-10-19: created (L2b)
stty_save gallery before
mark "gallery-start"
run_app "$bin/gallery"
if {[first_frame "gallery" "Families"]} {
    pump 500
    mark "gallery-down"; send "\x1b\[B"; pump 800
    mark "gallery-q"; send "\x11"
}
back_at_prompt "gallery"
stty_compare "gallery"

# ---- Assistant (--fake, the scripted provider: no network, no key): the
# first screen, type hi, Enter (the reply streams), then Ctrl-Q. Its files
# and its log go to the work dir (XDG_DATA_HOME, XDG_CONFIG_HOME).
# claude 2026-10-19: created (L3)
stty_save assistant before
mark "assistant-start"
run_app "XDG_DATA_HOME=$work XDG_CONFIG_HOME=$work $bin/assistant --fake"
if {[first_frame "assistant" "Chats"]} {
    pump 500
    # claude 2026-10-20: changed: wait for the end of the streamed reply (at
    # most 20 s), not a fixed 3 s pump; an INFO line gives the time
    mark "assistant-hi"; send "hi"; pump 300; send "\r"
    set took [await_reply 20000]
    if {$took >= 0} {
        lappend results "INFO assistant: the streamed reply ended $took ms after Enter"
    } else {
        lappend results "INFO assistant: the streamed reply did not end within 20 s after Enter"
    }
    mark "assistant-q"; send "\x11"
}
back_at_prompt "assistant"
stty_compare "assistant"

# ---- INFO: the classes that the start script of the Counter loads (start,
# first frame, q), counted by check.py from -Xlog:class+load. No PASS row.
file delete -force "$work/classload.log"
mark "classload-start"
run_app "JAVA_OPTS=-Xlog:class+load:file=$work/classload.log $bin/counter"
if {[ready_quiet "class-load run" "Count:"]} { send "q" }
expect {
    -re {EXIT=([0-9]+)} {
        lappend results "INFO class-load run: exit code $expect_out(1,string) (check.py counts $work/classload.log)"
    }
    timeout { fail "class-load run" "the app did not exit"; send "\003" }
}
wait_prompt

# ---- Stdin is a pipe: NotATerminal before anything changes
stty_save pipe before
mark "pipe-start"
run_app "echo | $bin/counter"
back_at_prompt "stdin is a pipe" {1}
stty_compare "pipe"

# ---- Native access denied (JDK 25: --illegal-native-access=deny forces the
# error that a JVM without --enable-native-access warns about)
# claude 2026-10-13: changed (T2): the main class is the TuiApp CounterApp
stty_save deny before
mark "deny-start"
run_app "\${JAVA_HOME:+\$JAVA_HOME/bin/}java --illegal-native-access=deny --sun-misc-unsafe-memory-access=allow -cp \"\$(cat $bin/classpath)\" examples.counter.CounterApp"
back_at_prompt "native access denied" {1}
stty_compare "deny"

mark "end"
send "exit\r"
expect eof
log_file
foreach r $results { send_user "$r\n" }
send_user "\nTerminal part: [llength [lsearch -all $results PASS*]] passed, [llength [lsearch -all $results FAIL*]] failed\n"
exit [expr {[llength [lsearch -all $results FAIL*]] > 0}]
