{
  "name": "tui4s-bench-infra",
  "private": true,
  "type": "module",
  "description": "The AWS run of the tui4s bench: one bucket, one role, one bounded EC2 instance (alchemy).",
  "scripts": {
    "alchemy": "ALCHEMY_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 alchemy",
    "fetch": "tsx fetch.ts",
    "whoami": "tsx whoami.ts",
    "check": "tsc --noEmit -p .",
    "fmt": "prettier --write '*.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@aws-sdk/client-sts": "3.1153.0",
    "alchemy": "0.94.0",
    "@aws-sdk/client-ssm": "3.1153.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "prettier": "3.9.10"
  }
}
