+NUMBERS = (
+    "zero one two three four five six seven eight nine ten eleven twelve thirteen"
+    " fourteen fifteen sixteen seventeen eighteen nineteen twenty"
+).split()
+
+
+def words(n: int) -> str:
+    if abs(n) > 20:
+        return str(n)
+    return ("minus " if n < 0 else "") + NUMBERS[abs(n)]
 
 
